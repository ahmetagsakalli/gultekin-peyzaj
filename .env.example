# Yayına çıkarken doğrulanmış HTTPS alan adını yazın ve yeniden build alın.
# Boşken canonical ve sitemap adresleri üretilmez; site yerelde çalışır.
SITE_URL=

# Sunucu ortamında tutulur; NEXT_PUBLIC_ öneki kullanmayın.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
ADMIN_SESSION_SECRET=
# İlk kurulumda bcrypt özeti. Düz metin şifre yazmayın.
# .env dosyasında bcrypt içindeki $ karakterlerini \$ biçiminde kaçırın.
ADMIN_PASSWORD_HASH=
